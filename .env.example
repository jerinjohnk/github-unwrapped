# GitHub personal access token used to fetch stats. Optional if you enter a key
# on the /studio page instead; required for the original home page.
# Create one at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# The URL the local server is reachable at.
VITE_HOST=http://localhost:8080

# Optional: GitHub OAuth app for "Sign in with GitHub" (includes private contributions).
# Callback URL must be ${VITE_HOST}/login. Leave empty to hide the sign-in buttons.
VITE_CLIENT_ID=
CLIENT_SECRET=

# Optional: Bitbucket Cloud, for Bitbucket videos on the /studio page.
# Create an API token with scopes at https://id.atlassian.com/manage-profile/security/api-tokens
# (Create API token with scopes > Bitbucket > read:user, read:workspace,
# read:repository, read:pullrequest). Leave empty to enter them on the page instead.
BITBUCKET_EMAIL=
BITBUCKET_API_TOKEN=
