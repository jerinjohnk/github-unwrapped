# Required: GitHub personal access token used to fetch stats.
# Create one at https://github.com/settings/tokens (no scopes needed for public data).
GITHUB_TOKEN=

# The URL the local server is reachable at.
VITE_HOST=http://localhost:8080

# Optional: GitHub OAuth app for "Sign in with GitHub" (includes private contributions).
# Callback URL must be ${VITE_HOST}/login. Leave empty to hide the sign-in buttons.
VITE_CLIENT_ID=
CLIENT_SECRET=
